    "oversizeDetails": {
      "description": "A bounded diagnostic for a value larger than the protocol's 16 MiB accepted limit. The exact alternative reports a measured integer above that limit through MAX_SAFE_INTEGER. The overflow alternative reports MAX_SAFE_INTEGER only as a lower bound, so a larger measurement is never presented as an exact value.",
      "type": "object",
      "required": ["field", "actual", "maximum", "actual_is_lower_bound"],
      "properties": {
        "field": {
          "$ref": "#/$defs/fieldName"
        },
        "actual": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "maximum": {
          "const": 16777216
        },
        "actual_is_lower_bound": {
          "type": "boolean"
        }
      },
      "oneOf": [
        {
          "description": "An exact size is represented directly.",
          "required": ["actual_is_lower_bound"],
          "properties": {
            "actual": {
              "type": "integer",
              "minimum": 16777217,
              "maximum": 9007199254740991
            },
            "maximum": {
              "const": 16777216
            },
            "actual_is_lower_bound": {
              "const": false
            }
          }
        },
        {
          "description": "An unrepresentable size is represented by a bounded lower bound at the safe integer cap.",
          "required": ["actual_is_lower_bound"],
          "properties": {
            "actual": {
              "const": 9007199254740991
            },
            "actual_is_lower_bound": {
              "const": true
            }
          }
        }
      ],
      "additionalProperties": false,
      "maxProperties": 4
    },

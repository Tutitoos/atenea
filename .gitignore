# Build output. The leading slash matters: a bare `atenea` would also match the
# cmd/atenea package directory.
/bin/
/dist/
/tmp/
/atenea
/coverage-summary.txt

# The coverage profile a benchmark run leaves behind. cmd/atenea-benchmark
# writes it, reads it once to compute the coverage figures it puts in
# summary.json, and never opens it again; summary.json and raw/ are the
# evidence a report is audited against. The committed copy was 858 KB of
# per-line counters that every run overwrites, so it only ever showed up as
# diff noise.
/benchmarks/runs/*/coverage.out

# Air hot reload
/build-errors.log

# Hugo
/docs/public/
/docs/resources/
/docs/.hugo_build.lock

# Local machine state
*.duckdb
*.duckdb.wal
.env
.DS_Store

# Serena writes a project config into whatever repository it is pointed at,
# holding a language-server setup and a memories folder that describe one
# machine and belong to nobody else.
/.serena/

# TokenSave keeps a project-local semantic index and token ledger here.
/.tokensave/

# Swift build output for the desktop helper. The helper is compiled on the
# machine that runs it and ships in no release, so this is always local.
helper/.build/

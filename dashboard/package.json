{
  "name": "@atenea/dashboard",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.0",
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build && bun run sync-dist",
    "sync-dist": "bun scripts/sync-dist.ts",
    "typecheck": "react-router typegen && tsc --noEmit",

    "@xyflow/react": "12.11.5",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "dagre": "0.8.5",
    "lucide-react": "0.511.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router": "7.18.3",
    "recharts": "3.10.1",
    "tailwind-merge": "3.3.0",
    "zod": "4.5.4",
    "isbot": "5.1.36"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.2.2",

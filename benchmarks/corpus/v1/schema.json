{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tutitoos.github.io/atenea/benchmarks/corpus/v1/schema.json",
  "title": "Atenea fixed acceptance corpus",
  "type": "object",
  "required": ["schema_version", "id", "version", "scenarios"],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "scenarios": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "items": {
        "type": "object",
        "required": ["id", "title", "capability", "language", "check", "fixture", "description"],
        "properties": {
          "id": {"type": "string", "pattern": "^S[0-9]{2}$"},
          "title": {"type": "string", "minLength": 1},
          "capability": {"type": "string", "minLength": 1},
          "language": {"type": "string", "minLength": 1},
          "check": {"type": "string", "minLength": 1},
          "fixture": {"type": "string", "minLength": 1},
          "description": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}

{
  "type": "object",
  "properties": {
    "session": {
      "type": "string",
      "description": "Agent-device session name."
    },
    "platform": {
      "type": "string",
      "enum": [
        "apple",
        "android",
        "harmonyos",
        "vega",
        "linux",
        "web",
        "ios",
        "macos"
      ],
      "description": "Platform selector used to resolve a device."
    },
    "deviceTarget": {
      "type": "string",
      "enum": [
        "mobile",
        "tv",
        "desktop"
      ],
      "description": "Device target form. Maps to the CLI --target flag."
    },
    "target": {
      "type": "string",
      "enum": [
        "mobile",
        "tv",
        "desktop"
      ],
      "description": "Alias for deviceTarget on commands without a UI target field. Interaction commands reserve target for the UI element."
    },
    "device": {
      "type": "string",
      "description": "Device name selector (a UDID belongs in udid, a serial in serial)."
    },
    "udid": {
      "type": "string",
      "description": "Apple device or simulator UDID; the selector that pins one device when several share a name."
    },
    "serial": {
      "type": "string",
      "description": "Android, HarmonyOS, or Vega VVD serial selector."
    },
    "androidDeviceAllowlist": {
      "type": "string",
      "description": "Android serial allowlist used for device resolution."
    },
    "tenant": {
      "type": "string",
      "description": "Remote tenant identifier."
    },
    "runId": {
      "type": "string",
      "description": "Lease run identifier."
    },
    "leaseId": {
      "type": "string",
      "description": "Existing lease identifier."
    },
    "debug": {
      "type": "boolean",
      "description": "Enable debug diagnostics."
    },
    "from": {
      "type": "object",
      "description": "Swipe start point.",
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        }
      },
      "required": [
        "x",
        "y"
      ],
      "additionalProperties": false
    },
    "to": {
      "type": "object",
      "description": "Swipe end point.",
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        }
      },
      "required": [
        "x",
        "y"
      ],
      "additionalProperties": false
    },
    "count": {
      "type": "integer",
      "description": "Number of swipe repetitions.",
      "minimum": 1,
      "maximum": 200
    },
    "pauseMs": {
      "type": "integer",
      "description": "Pause between repeated swipes.",
      "minimum": 0,
      "maximum": 10000
    },
    "pattern": {
      "type": "string",
      "enum": [
        "one-way",
        "ping-pong"
      ]
    },
    "noRecord": {
      "type": "boolean",
      "description": "Do not record this action."
    },
    "mcpOutputFormat": {
      "type": "string",
      "enum": [
        "optimized",
        "json"
      ],
      "description": "MCP text content format. Defaults to optimized agent-friendly text; use json for JSON text. Structured content is always returned separately."
    },
    "includeCost": {
      "type": "boolean",
      "description": "Include per-command agent-cost (cost.wallClockMs, …) in structuredContent. Defaults to off; the default response shape is unchanged."
    },
    "responseLevel": {
      "type": "string",
      "enum": [
        "digest",
        "default",
        "full"
      ],
      "description": "Response verbosity: token-cheap digest / default (today) / full. Defaults to default; the default response shape is unchanged."
    }
  },
  "required": [
    "from",
    "to"
  ],
  "additionalProperties": false
}

DOC = os.path.join(HOME, ".config", "atenea", "CLIENTS.md")


def trust_warning():
    """Say what accepting Claude's trust dialog would switch on, before it is asked.

    A project .mcp.json is inert until the project is trusted. That makes the
    trust dialog - not any config file - the real trigger, and a dialog is
    answered in a hurry. So the warning has to arrive with the launch, which is
    why the `claude` shell function calls this before handing over to the wrap.
    """
    d = os.getcwd()
    seen = []
    while d.startswith(HOME) and len(d) >= len(HOME):
        seen.append(d)
        if d == HOME:
            break
        d = os.path.dirname(d)
    try:
        projects = load_json(os.path.join(HOME, ".claude.json")).get("projects") or {}
    except (OSError, ValueError):
        return 0
    for root in seen:
        mcp = os.path.join(root, ".mcp.json")
        if not os.path.isfile(mcp):
            continue
        try:
            declared = set(json.load(open(mcp)).get("mcpServers", {}) or {})
        except (OSError, ValueError):
            continue
        clash = declared & BACKENDS
        if not clash:
            continue
        if (projects.get(root) or {}).get("hasTrustDialogAccepted"):
            continue
        # stderr, not stdout: this runs in front of a wrapped command, and a
        # warning that lands in `claude mcp list --json` corrupts it silently.
        banner = [
            "",
            "  " + " SI CLAUDE TE PIDE CONFIAR EN ESTE PROYECTO ".center(70, "!"),
            f"  {root.replace(HOME, '~')}/.mcp.json declara {sorted(clash)},",
            "  que son los backends que atenea YA ejecuta por dentro. Aceptar los",
            "  anade AL LADO de atenea: los mismos motores dos veces.",
            f"  El porque, y que hacer si lo aceptas: {DOC.replace(HOME, '~')}",
            "  " + "!" * 70,
            "",
        ]
        print("\n".join(banner), file=sys.stderr)
        return 1
    return 0


def effective_policy(client):
    """Mirror ResolveDesktopProfile for file-only diagnosis, with explicit provenance.

    This describes the wrapper policy. It does not claim a wrapper ran.
    """
    filename = os.environ.get("ATENEA_CONFIG") or os.path.join(HOME,".config","atenea","atenea.toml")
    try:
        config = load_toml(filename)
    except (OSError, ValueError):
        notes.append(f"{client}: politica Atenea sin verificar")
        return None
    name = "claude" if client == "claude" else "chatgpt" if client in ("codex","chatgpt") else "shared"
    overrides = [arg.split("=",1)[1] for arg in sys.argv if arg.startswith("--profile=")]
    if overrides:
        name = overrides[-1]
    defaults = {"claude":{"mcp_mode":"atenea_only"},
                "chatgpt":{"mcp_mode":"atenea_only"},
                "shared":{"mcp_mode":"hybrid","direct_mcp":["*"]},
                "agent-device-full":{"mcp_mode":"atenea_only"}}
    profile = next((row for row in config.get("desktop_profile",[]) if row.get("name")==name), defaults.get(name))
    if profile is None or (profile.get("clients") and client not in profile["clients"] and "*" not in profile["clients"]):
        fail("policy", f"{client}: perfil incompatible {name}", "verifica --profile y desktop_profile.clients")
        return None
    served = {row.get("provider") for row in config.get("implementation",[])}
    direct = []
    if profile.get("mcp_mode") == "hybrid":
        allowed = profile.get("direct_mcp",[])
        direct = sorted(row["id"] for row in config.get("mcp_server",[])
                        if row.get("expose")=="on" and row.get("id") not in served
                        and ("*" in allowed or row.get("id") in allowed))
    return {"profile":name,"mode":profile.get("mcp_mode"),
            "expected_wrapper_servers":["atenea"]+direct,
            "source":filename,"injected_configuration":"unobserved",
            "received_tools":"unobserved"}


def audit_client_declarations(client):
    policy = effective_policy(client)
    locations = {
        "omp":[os.path.join(os.environ.get("PI_CODING_AGENT_DIR") or os.path.join(HOME,".omp","agent"),"mcp.json")],
        "claude":[os.path.join(HOME,".claude.json")],
        "codex":[os.path.join(HOME,".codex","config.toml")],
        "opencode":opencode_configs(),
    }
    declared = {}
    sources = []
    for filename in locations[client]:
        if not os.path.isfile(filename):
            continue
        document = load_toml(filename) if filename.endswith(".toml") else load_jsonc(filename)
        key = "mcp_servers" if client=="codex" else "mcp" if client=="opencode" else "mcpServers"
        for name, value in (document.get(key) or {}).items():
            declared[name] = {"enabled": value.get("enabled",True) and name not in document.get("disabledServers",[])}
        sources.append(filename.replace(HOME,"~"))
    rows.append((client, sorted(declared), ", ".join(sources) or "sin declaracion en disco"))
    if policy:
        notes.append(client+": "+json.dumps(policy,sort_keys=True))
    notes.append(f"{client}: disco={len(declared)}; la inyeccion del wrapper y las tools recibidas requieren evidencia independiente")
    # Retired declarations are a concrete conflict even if this particular
    # launch later suppresses them. Missing disk entries prove no absence.
    if "serena" in declared and declared["serena"]["enabled"]:
        fail("retired",f"{client}: Serena sigue habilitada en disco","el proveedor esta retirado")


# ---------------------------------------------------------------- main
def wire_clients_from_argv():
    """--client=NAME, repeatable; absent means all four."""
    picked = [a.split("=", 1)[1] for a in sys.argv if a.startswith("--client=")]
    unknown = [c for c in picked if c not in WIRE_PROBES]
    if unknown:
        print(f"mcp-agree: cliente desconocido: {', '.join(unknown)}. "
              f"Conocidos: {', '.join(sorted(WIRE_PROBES))}", file=sys.stderr)
        return None
    return picked or ["claude", "omp", "opencode", "codex"]


def main():
    live = "--live" in sys.argv
    quiet = "--quiet" in sys.argv

    if "--trust-warning" in sys.argv:
        return trust_warning()

    if "--wire" in sys.argv:
        clients = wire_clients_from_argv()
        if clients is None:
            return 2
        measured = run_wire(clients)
        if fails:
            for case, what, why in fails:
                print(f"\n  [{case}] {what}")
                print(f"          {why}")
            return 1
        return 0 if all(value and value.get("names") for value in measured.values()) else 3

    clients = wire_clients_from_argv()
    if clients is None:
        return 2
    for fn in ([lambda client=client: audit_client_declarations(client) for client in clients] + [check_serena]):
        try:
            fn()
        except FileNotFoundError as exc:
            print(f"mcp-agree: no puedo leer {exc.filename}", file=sys.stderr)
            return 2
        except (ValueError, tomllib.TOMLDecodeError) as exc:
            print(f"mcp-agree: fichero ilegible: {exc}", file=sys.stderr)
            return 2
    if live:
        check_live()

    fp = fingerprint()
    account_text, account_verified = account_line(load_surface(), fp)

    if fails:
        print()
        print("  NO COINCIDEN  ".center(74, "="))
        print("  Solo declaraciones en disco; no verifica inyeccion de wrappers ni sesiones.")
        for case, what, why in fails:
            print(f"\n  [{case}] {what}")
            print(f"          {why}")
        print()
        for client, names, src in rows:
            print(f"  {client:<9} {', '.join(names) or '(ninguno)':<34} {src}")
        print()
        print(f"  ficheros  ROJO      fingerprint {fp}")
        print(f"  cuenta    {account_text}")
        print("=" * 74)
        return 1

    if not quiet:
        for client, names, src in rows:
            print(f"  {client:<9} {', '.join(names):<34} {src}")
        for note in notes:
            print(f"  nota: {note}")
        print(f"  ficheros  LEIDOS    politica y declaraciones separadas · fingerprint {fp}")
        print(f"  cuenta    {account_text}")
    if not account_verified:
        # Deliberately not 0: the file surface agrees, and that is all this run
        # can say. The account surface has no file to agree with.
        return 3
    return 0


if __name__ == "__main__":
    sys.exit(main())

def _recorder():
    """A loopback endpoint that records one request body and refuses it.

    Port 0: the kernel picks it, so two probes can never collide and nothing
    has to be reserved. Every answer is 400 - a probe that succeeded would be
    a model call somebody pays for.
    """
    import threading
    from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

    seen = []

    class Handler(BaseHTTPRequestHandler):
        def log_message(self, *_args):  # silence: this runs in front of a report
            pass

        def _refuse(self):
            body = (b'{"type":"error","error":{"type":"invalid_request_error",'
                    b'"message":"mcp-agree probe"}}')
            self.send_response(400)
            self.send_header("content-type", "application/json")
            self.send_header("content-length", str(len(body)))
            self.end_headers()
            self.wfile.write(body)

        def do_GET(self):
            self._refuse()

        def do_POST(self):
            raw = self.rfile.read(int(self.headers.get("content-length") or 0))
            try:
                payload = json.loads(raw)
            except ValueError:
                payload = None
            if isinstance(payload, dict):
                seen.append(payload)
            self._refuse()

    srv = ThreadingHTTPServer(("127.0.0.1", 0), Handler)
    threading.Thread(target=srv.serve_forever, daemon=True).start()
    return srv, seen


def group_tools(names):
    """builtin, or mcp:<server>, from the mcp__<server>__<tool> convention."""
    groups = {}
    for name in names:
        name = str(name)
        if name.startswith("mcp__"):
            key = "mcp:" + name[len("mcp__"):].split("__")[0]
        else:
            key = "builtin"
        groups[key] = groups.get(key, 0) + 1
    return groups


def mem_routes(body):
    """Distinct claude-mem route names anywhere in the request body.

    Not read off `tools[]` on purpose. omp does not put its MCP tools there -
    it mounts them as xd:// routes named in the system prompt - so a census
    that only walks `tools[]` sees zero claude-mem for omp and cannot notice
    the backend being mounted twice. Measured 2026-08-13: 28 distinct routes
    for 14 tools, two spellings of one server.
    """
    blob = json.dumps(body, ensure_ascii=False)
    names = set(re.findall(r"mcp__[A-Za-z0-9_-]+", blob))
    return len({n for n in names
                if "claudemem" in n.lower().replace("_", "").replace("-", "")})


def probe_wire(client, timeout=90):
    """Spawn one client at a recorder and return what it put on the wire.

    Returns {names, groups, account, bytes, seconds} or None, having said why.
    """
    import time

    if client == "opencode":
        notes.append("opencode: el puente historico de Claude no acredita este cliente; usa --live para el perfil shared")
        return None
    spec = WIRE_PROBES[client]
    srv, seen = _recorder()
    port = str(srv.server_address[1])
    argv = [a.replace("{port}", port) for a in spec["argv"]]
    env = dict(os.environ)
    env.update({k: v.replace("{port}", port) for k, v in spec["env"].items()})
    started = time.monotonic()
    try:
        subprocess.run(argv, env=env, cwd=HOME, stdin=subprocess.DEVNULL,
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                       timeout=timeout)
    except FileNotFoundError:
        fail("wire", f"{client}: no encuentro {argv[0]}",
             "sin el binario no hay superficie que medir")
        return None
    except subprocess.TimeoutExpired:
        fail("wire", f"{client}: la sonda no termino en {timeout}s",
             "el cliente se quedo esperando algo; la medicion no vale")
        return None
    finally:
        srv.shutdown()
        srv.server_close()
    seconds = round(time.monotonic() - started, 1)

    bodies = [b for b in seen if isinstance(b.get("tools"), list)]
    if not bodies:
        if seen:
            return {"names": [], "groups": {}, "account": 0, "bytes": 0,
                    "claude_mem": mem_routes(seen[-1]), "seconds": seconds}
        fail("wire", f"{client}: no llego ninguna peticion a la sonda",
             "el cliente no honro la variable de base URL, o murio antes")
        return None
    body = max(bodies, key=lambda b: len(b["tools"]))
    names = [t.get("name") for t in body["tools"]]
    # Byte-for-byte what a JSON client puts on the wire. Python's defaults add
    # ", "/": " and \uXXXX-escape non-ASCII: on the 77-tool body measured
    # 2026-08-13 that is 133,336 bytes against the capture's 129,225 - a 3.2%
    # phantom that reads exactly like a surface change. Compact + raw UTF-8
    # reproduces the capture to within one byte.
    return {
        "names": names,
        "groups": group_tools(names),
        "account": sum(1 for n in names if str(n).startswith(ACCOUNT_PREFIX)),
        "bytes": wire_bytes(body["tools"]),
        "claude_mem": mem_routes(body),
        "seconds": seconds,
    }


def wire_bytes(tools):
    """Size of the tools array as a client serialises it: compact, raw UTF-8."""
    return len(json.dumps(tools, separators=(",", ":"),
                          ensure_ascii=False).encode("utf-8"))


def render_wire(client, surface):
    """One line per client: the total, then who contributed it."""
    if surface is None:
        return f"  {client:<9} (sin medir)"
    groups = surface["groups"]
    account = surface["account"]
    parts = [f"{k.replace('mcp:', '')} {v}" for k, v in sorted(groups.items())
             if not k.startswith(ACCOUNT_GROUP_PREFIX)]
    tail = f" · cuenta {account}" if account else ""
    total = len(surface["names"])
    mem = surface.get("claude_mem", 0)
    mem_part = f" · claude-mem rutas {mem}" if mem else ""
    return (f"  {client:<9} {total:>3} tools  {' · '.join(parts)}{tail}{mem_part}"
            f"  [{surface['bytes']} B compact, {surface['seconds']}s]")


# The surface as measured 2026-08-13, per client, on the wire. `groups` is
# checked exactly where a client carries MCP tools; `claude_mem` is checked
# everywhere, because that backend is DECLARED TWICE on this machine and one
# declaration is only silenced by a name list - exactly the kind of list that
# went missing from ~/.omp/agent/mcp.json on 2026-08-11 at 18:06 and was not
# noticed for two days. Suppressed is not removed. Update these WITH a dated
# measurement, never to make a red run go quiet.
def check_wire_invariants(client, surface):
    """The rules a measurement must satisfy. Violations are red, not notes."""
    if surface is None:
        return
    try:
        deny = load_json(os.path.join(HOME,".claude","settings.json")).get("permissions",{}).get("deny",[])
    except (OSError,ValueError):
        deny = []
    if surface["account"] and "mcp__claude_ai_*" in deny:
        offenders = sorted({str(n).split("__")[1] for n in surface["names"]
                            if str(n).startswith(ACCOUNT_PREFIX)})
        fail("wire", f"{client} lleva {surface['account']} herramientas de cuenta "
                     f"({', '.join(offenders)})",
             "los conectores de la sesion OAuth volvieron al cable. La negacion "
             "vive en ~/.claude/settings.json permissions.deny como "
             '"mcp__claude_ai_*"; si sigue ahi, es que dejo de aplicarse')
    policy = effective_policy(client)
    if not surface.get("names"):
        notes.append(f"{client}: el cuerpo capturado no acredita las tools recibidas")
        return
    if policy and policy["mode"] == "atenea_only":
        direct = {group[4:] for group in surface["groups"] if group.startswith("mcp:")
                  and not group.startswith(ACCOUNT_GROUP_PREFIX)}
        unexpected = direct - {"atenea"}
        if unexpected:
            fail("wire",f"{client}: MCP directos fuera de la politica {sorted(unexpected)}",
                 "contrasta el wrapper realmente ejecutado, la configuracion inyectada y los plugins del cliente")
    notes.append(f"{client}: catalogo medido; recuentos historicos no se usan como contrato")


def run_wire(clients):
    """Measure the real surface of each client, print it, and remember it."""
    measured = {}
    for client in clients:
        surface = probe_wire(client)
        measured[client] = surface
        print(render_wire(client, surface))
        note = WIRE_PROBES[client]["note"]
        if note and surface is not None:
            print(f"  {'':<9} {note}")
        check_wire_invariants(client, surface)
    save_surface(measured)
    return measured


# ---------------------------------------------------- remembering a measurement
# A wire measurement is expensive, so it is cached - but a cache that outlives
# its subject is a lie with a timestamp. Two guards, and they cover different
# things on purpose:
#
#   fingerprint  every FILE that can change the surface. Cheap: six stats.
#   session      the inputs that have no file. The mcp__claude_ai_* connectors
#                live on the claude.ai account, and on 2026-08-13 an unrelated
#                built-in (ListAgents) appeared on the wire inside a FIFTEEN
#                MINUTE window with no local file changed, no binary upgraded
#                and identical flags. A channel that moves in fifteen minutes
#                cannot be bounded by a clock: any expiry long enough to be
#                useful is long enough to be wrong. So there is no TTL. A
#                measurement counts as current only inside the shell session
#                that took it; everywhere else it is reported with its date and
#                treated as unverified (exit 3).
SURFACE_CACHE = os.path.join(HOME, ".claude", ".mcp-agree-surface.json")
STAT_INPUTS = [
    os.path.join(HOME, ".claude", "settings.json"),
    os.path.join(HOME, ".omp", "agent", "mcp.json"),
    os.path.join(HOME, ".codex", "config.toml"),
    os.path.join(HOME, ".config", "opencode", "opencode.json"),
    os.path.join(HOME, ".config", "atenea", "atenea.toml"),
    CLAUDE_BIN,
] + opencode_configs() + [os.path.join(os.environ.get("PI_CODING_AGENT_DIR") or
                                     os.path.join(HOME, ".omp", "agent"), "mcp.json")]


SHELLS = {"bash", "zsh", "fish", "sh", "dash", "ksh", "tcsh", "csh"}


def proc_stat(pid):
    """(comm, ppid, starttime) for a pid. comm can hold spaces and parens, so
    split on the LAST ')' - the usual first-')' bug misreads `(sh -c)`."""
    with open(f"/proc/{pid}/stat") as fh:
        raw = fh.read()
    head, _, rest = raw.rpartition(")")
    fields = rest.split()
    return head.partition("(")[2], int(fields[1]), fields[19]


def session_token():
    """Identify the shell session, so a measurement cannot outlive it.

    The nearest ancestor shell, as pid:starttime - the pair survives pid reuse
    and changes the moment another terminal, or a nested shell, opens.

    NOT the session id, which was the first attempt and was wrong here:
    measured 2026-08-13, this agent harness runs every command under its own
    setsid, so three consecutive invocations reported sids 2497260, 2497261,
    2497264 while the shell above them stayed 2151557. Keyed on getsid() the
    cache could never be current and --wire would have been unusable from any
    such runner. Under an interactive terminal both readings agree; the
    ancestor walk is the one that also survives a wrapper.

    No shell above us (daemon, cron): fall back to the session id, and if /proc
    cannot answer at all return a unique token - unverified, never current.
    """
    try:
        pid = proc_stat(os.getpid())[1]
        for _ in range(24):
            comm, ppid, starttime = proc_stat(pid)
            if comm in SHELLS:
                return f"{pid}:{starttime}"
            if ppid <= 1:
                break
            pid = ppid
        sid = os.getsid(0)
        return f"sid{sid}:{proc_stat(sid)[2]}"
    except (OSError, IndexError, ValueError):
        return f"unknown:{os.urandom(8).hex()}"


def fingerprint():
    """Hash of everything on disk that can move the surface.

    ~/.claude.json is deliberately NOT stat'ed: every claude start rewrites it
    (measured 2026-08-10), so its mtime changes hourly while the surface does
    not. Its CONTENT contributes instead - the user-scope servers and the
    account identity, which are the two parts of that file the surface depends
    on.
    """
    import hashlib

    h = hashlib.sha256()
    for path in STAT_INPUTS + [shutil.which(client) or client for client in WIRE_PROBES] + [os.environ.get("ATENEA_CONFIG", "")]:
        try:
            st = os.stat(path)
            h.update(f"{path}:{st.st_mtime_ns}:{st.st_size}\n".encode())
        except OSError:
            h.update(f"{path}:missing\n".encode())
    try:
        d = load_json(os.path.join(HOME, ".claude.json"))
        h.update(json.dumps(sorted((d.get("mcpServers") or {}))).encode())
        h.update(str((d.get("oauthAccount") or {}).get("accountUuid")).encode())
    except (OSError, ValueError):
        h.update(b"claude.json:unreadable")
    return h.hexdigest()[:16]


def save_surface(measured):
    """Write the measurement with the fingerprint that was true when it ran."""
    import datetime

    now = datetime.datetime.now(datetime.timezone.utc).isoformat(timespec="seconds")
    fp = fingerprint()
    try:
        stored = load_json(SURFACE_CACHE)
    except (OSError, ValueError):
        stored = {}
    clients = stored.get("clients") or {}
    for client, surface in measured.items():
        if surface is None or not surface.get("names"):
            continue
        clients[client] = {
            "count": len(surface["names"]),
            "groups": surface["groups"],
            "account": surface["account"],
            "bytes": surface["bytes"],
            "claude_mem": surface.get("claude_mem", 0),
            "measured_at": now,
            "fingerprint": fp,
            "session": session_token(),
        }
    try:
        with open(SURFACE_CACHE, "w") as fh:
            json.dump({"version": 1, "clients": clients}, fh, indent=2, sort_keys=True)
    except OSError as exc:
        notes.append(f"no pude guardar la medicion: {exc}")


def load_surface():
    try:
        return (load_json(SURFACE_CACHE).get("clients") or {})
    except (OSError, ValueError):
        return {}


def account_line(cached, fp):
    """The account surface, which is never green - only measured, or unknown.

    Returns (text, verified). `verified` is true only for a measurement taken
    in THIS shell session: the channel moved by one tool in fifteen minutes on
    2026-08-13 with nothing on disk to show for it, so a measurement from an
    earlier session is a fact about an earlier session. It never means the file
    surface failed, and it can never make the whole verdict green on its own.
    """
    entry = cached.get("claude")
    if not entry or not entry.get("count"):
        return ("sin medir nunca · corre `mcp-agree --wire`", False)
    when = entry.get("measured_at", "?")
    body = (f"medida {when[:10]} · {entry.get('count', '?')} tools en el cable "
            f"· mcp__claude_ai_* = {entry.get('account', '?')}")
    if entry.get("fingerprint") != fp:
        return (f"{body} — CADUCA: la config cambio desde entonces", False)
    if entry.get("session") != session_token():
        return (f"{body} — otra sesion: la cuenta no deja rastro en disco, "
                "mide en esta", False)
    return (body, True)




# ---------------------------------------------------------------- live
def handshake(name, cmd, args, env_extra=None, want_names=False,
              client_name="mcp-agree", client_version="unknown", timeout=30,
              want_metadata=False):
    """Bounded MCP discovery under the actual client identity/profile."""
    env = dict(os.environ)
    env.update(env_extra or {})
    process = None
    messages = queue.Queue()
    deadline = time.monotonic() + timeout
    try:
        process = subprocess.Popen([cmd] + args, stdin=subprocess.PIPE,
                                   stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
                                   text=True, bufsize=1, env=env)
        def read():
            try:
                while True:
                    line = process.stdout.readline(8 * 1024 * 1024 + 1)
                    if not line:
                        break
                    if len(line) <= 8 * 1024 * 1024:
                        try:
                            messages.put(json.loads(line))
                        except ValueError:
                            pass
                    else:
                        break
            except (OSError, ValueError):
                pass
            finally:
                messages.put(None)
        threading.Thread(target=read, daemon=True).start()
        def send(message):
            process.stdin.write(json.dumps(message) + "\n")
            process.stdin.flush()
        def response(identifier):
            while True:
                remaining = deadline - time.monotonic()
                if remaining <= 0:
                    raise TimeoutError("MCP discovery timed out")
                message = messages.get(timeout=remaining)
                if message is None:
                    raise ValueError("MCP process ended before its response")
                if not isinstance(message, dict):
                    raise ValueError("invalid MCP envelope")
                if message.get("id") == identifier:
                    if "error" in message:
                        raise ValueError("MCP rejected discovery")
                    return message.get("result", {})
        send({"jsonrpc":"2.0", "id":1, "method":"initialize",
              "params":{"protocolVersion":"2024-11-05", "capabilities":{},
                        "clientInfo":{"name":client_name,"version":client_version}}})
        initialized = response(1)
        send({"jsonrpc":"2.0", "method":"notifications/initialized"})
        served = []
        cursor = None
        identifier = 2
        seen = set()
        while True:
            send({"jsonrpc":"2.0", "id":identifier, "method":"tools/list",
                  "params": {} if cursor is None else {"cursor":cursor}})
            page = response(identifier)
            tools = page.get("tools", [])
            if not isinstance(tools, list) or any(not isinstance(tool, dict) or not isinstance(tool.get("name"), str) for tool in tools):
                raise ValueError("invalid MCP catalog")
            served.extend(tools)
            cursor = page.get("nextCursor")
            if not cursor:
                break
            if cursor in seen:
                raise ValueError("MCP catalog repeated its cursor")
            seen.add(cursor)
            identifier += 1
        if want_metadata:
            schemas = {tool["name"]: {key:tool[key] for key in
                       ("inputSchema", "outputSchema") if key in tool} for tool in served}
            digest = hashlib.sha256(json.dumps(schemas, sort_keys=True,
                                    separators=(",", ":")).encode()).hexdigest()
            return {"client":client_name,"client_version":client_version,
                    "server":initialized.get("serverInfo", {}), "tools":[tool["name"] for tool in served],
                    "schema_hash":digest,"observed_at":time.time(),
                    "evidence":"direct_handshake; host-delivered tools remain separate"}
        return [tool["name"] for tool in served] if want_names else len(served)
    except (OSError, ValueError, TimeoutError, queue.Empty):
        fail("live", f"{name}: descubrimiento MCP no verificado",
             "inicio, protocolo o plazo fallido; ningun recuento sustituye esta evidencia")
        return None
    finally:
        if process is not None:
            if process.poll() is None:
                process.terminate()
                try:
                    process.wait(timeout=2)
                except subprocess.TimeoutExpired:
                    process.kill()
                    process.wait(timeout=2)
            if process.stdin:
                try:
                    process.stdin.close()
                except (OSError, ValueError):
                    pass
            if process.stdout:
                process.stdout.close()


def check_live():
    """Measure each policy separately; never infer the host's tool surface."""
    atenea = os.environ.get("ATENEA_BIN") or shutil.which("atenea") or os.path.join(BIN,"atenea")
    for client in wire_clients_from_argv() or []:
        policy = effective_policy(client)
        if policy is None:
            continue
        measured = handshake("atenea/"+client, atenea,
                             ["mcp", "--desktop-profile", policy["profile"]],
                             client_name=client, want_metadata=True)
        if measured is not None:
            notes.append("handshake " + json.dumps({**measured, "profile":policy["profile"]}, sort_keys=True))



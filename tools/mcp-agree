# ---------------------------------------------------------------- omp
def check_omp():
    path = os.path.join(os.environ.get("PI_CODING_AGENT_DIR") or
                        os.path.join(HOME, ".omp", "agent"), "mcp.json")
    try:
        d = load_json(path)
    except FileNotFoundError:
        # OMP permits an absent user file and discovers other sources. This
        # audit cannot infer that discovery from config.yml (not MCP config).
        d = {}
        notes.append("omp: sin MCP de usuario; descubrimiento/proyecto sin verificar")
    servers = d.get("mcpServers", {}) or {}
    names = set(servers)
    rows.append(("omp", sorted(names), path.replace(HOME, "~")))

    extra = names - CORE
    reintroduced = extra & BACKENDS
    if reintroduced:
        fail("installer", f"omp declara {sorted(reintroduced)} ademas del core",
             "firma de `kena agent setup`: fillMissing() los repone con enabled:true. "
             "Son los backends que atenea ya ejecuta -> motores duplicados, ~43 -> ~80 "
             "herramientas. Borralos de mcpServers; disabledServers NO los tapa.")
    for name in sorted(extra - BACKENDS):
        fail("toggle", f"omp declara un servidor inesperado: {name}",
             "no estaba en el acuerdo; alguien lo anadio")
    for name in sorted(CORE - names):
        fail("declaration", f"omp no declara {name} a nivel usuario",
             "no demuestra ausencia en runtime: descubrimiento y wrappers fuera de esta comprobacion")

    for name in sorted(CORE & names):
        s = servers[name]
        if s.get("enabled", True) is not True or name in (d.get("disabledServers") or []):
            fail("toggle", f"omp tiene {name} con enabled={s.get('enabled')!r}",
                 "servidor deshabilitado por entrada o disabledServers")
        cmd = s.get("command", "")
        if not os.path.isabs(cmd):
            fail("toggle", f"omp lanza {name} con un comando no absoluto: {cmd!r}",
                 "regla 28: depende del PATH que omp pase; si no resuelve es una "
                 "herramienta que falta, no un error")
        elif not os.access(cmd, os.X_OK):
            fail("toggle", f"omp apunta {name} a {cmd}, que no es ejecutable",
                 "el servidor no arrancara y el cliente no lo dira")

    missing = OMP_SUPPRESSED - set(d.get("disabledServers") or [])
    if missing:
        fail("toggle", f"omp ya no suprime {sorted(missing)}",
             "vuelven por descubrimiento desde opencode/marketplace y se duplican")



